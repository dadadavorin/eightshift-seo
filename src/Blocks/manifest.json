{
	"$schema": "https://raw.githubusercontent.com/infinum/eightshift-frontend-libs-tailwind/main/schemas/globalManifest.json",
	"namespace": "eightshift-seo",
	"background": "#FFFFFF",
	"foreground": "#1D4ED8",
	"config": {
		"useWrapper": false,
		"useBlocks": false,
		"useComponents": true,
		"useVariations": false
	},
	"globalVariables": {
		"breakpoints": {}
	},

	"caps": {
		"manage": {
			"id": "eightshift_seo_manage",
			"help": "Manage Eightshift SEO settings"
		}
	},

	"adminPagesPrefix": "es-seo-",
	"optionsName": "es-seo-settings",

	"meta": {
		"title": "es_seo_title",
		"description": "es_seo_description",
		"noindex": "es_seo_noindex",
		"nofollow": "es_seo_nofollow",
		"canonical": "es_seo_canonical",
		"ogTitle": "es_seo_og_title",
		"ogDescription": "es_seo_og_description",
		"ogImage": "es_seo_og_image",
		"twitterTitle": "es_seo_twitter_title",
		"twitterDescription": "es_seo_twitter_description",
		"twitterImage": "es_seo_twitter_image",
		"twitterCardType": "es_seo_twitter_card_type",
		"focusKeyphrase": "es_seo_focus_keyphrase",
		"primaryCategory": "es_seo_primary_category",
		"maxSnippet": "es_seo_max_snippet",
		"maxImagePreview": "es_seo_max_image_preview",
		"maxVideoPreview": "es_seo_max_video_preview",
		"noarchive": "es_seo_noarchive",
		"nosnippet": "es_seo_nosnippet",
		"noimageindex": "es_seo_noimageindex",
		"notranslate": "es_seo_notranslate",
		"unavailableAfter": "es_seo_unavailable_after",
		"hreflangDisabled": "es_seo_hreflang_disabled",
		"noai": "es_seo_noai",
		"noimageai": "es_seo_noimageai",
		"tldr": "es_seo_tldr",
		"citations": "es_seo_citations",
		"speakableSelectors": "es_seo_speakable_selectors",
		"faq": "es_seo_faq",
		"howto": "es_seo_howto"
	},

	"termMeta": {
		"title": "es_seo_term_title",
		"description": "es_seo_term_description",
		"noindex": "es_seo_term_noindex",
		"nofollow": "es_seo_term_nofollow",
		"canonical": "es_seo_term_canonical",
		"ogTitle": "es_seo_term_og_title",
		"ogDescription": "es_seo_term_og_description",
		"ogImage": "es_seo_term_og_image",
		"twitterTitle": "es_seo_term_twitter_title",
		"twitterDescription": "es_seo_term_twitter_description",
		"twitterImage": "es_seo_term_twitter_image",
		"noarchive": "es_seo_term_noarchive",
		"nosnippet": "es_seo_term_nosnippet",
		"noimageindex": "es_seo_term_noimageindex",
		"notranslate": "es_seo_term_notranslate"
	},

	"filters": {
		"canonical": "es_seo_canonical",
		"robots": "es_seo_robots",
		"ogTags": "es_seo_og_tags",
		"twitterTags": "es_seo_twitter_tags",
		"breadcrumbSchema": "es_seo_breadcrumb_schema",
		"sitemapPostTypes": "es_seo_sitemap_post_types",
		"sitemapTaxonomies": "es_seo_sitemap_taxonomies",
		"titleTemplate": "es_seo_title_template",
		"descriptionTemplate": "es_seo_description_template",
		"templateTokens": "es_seo_template_tokens",
		"templateTokensDateFormat": "es_seo_template_tokens_date_format",
		"supportedPostTypes": "es_seo_supported_post_types",
		"siteRepresentationSchema": "es_seo_site_representation_schema",
		"webmasterVerificationTags": "es_seo_webmaster_verification_tags",
		"hreflangAlternates": "es_seo_hreflang_alternates",
		"indexNowSubmit": "es_seo_indexnow_submit",
		"enableUsersSitemap": "es_seo_enable_users_sitemap",
		"imageSitemapEntry": "es_seo_image_sitemap_entry",
		"healthChecks": "es_seo_health_checks",
		"schemaGraph": "es_seo_schema_graph",
		"schemaContext": "es_seo_schema_context",
		"aiBotRegistry": "es_seo_ai_bot_registry",
		"aiCrawlerRobotsTxt": "es_seo_ai_crawler_robots_txt",
		"schemaNodeOrganization": "es_seo_schema_node_organization",
		"schemaNodePerson": "es_seo_schema_node_person",
		"articleSchemaNode": "es_seo_article_schema_node",
		"webpageSchemaNode": "es_seo_webpage_schema_node",
		"articleType": "es_seo_article_type",
		"speakableDefaultSelectors": "es_seo_speakable_default_selectors",
		"faqRender": "es_seo_faq_render",
		"howtoRender": "es_seo_howto_render",
		"citationsRender": "es_seo_citations_render",
		"llmSitemapEntry": "es_seo_llm_sitemap_entry"
	},

	"optionsDefaultValue": {
		"titleTemplates": {
			"post": "%title% %sep% %sitename%",
			"page": "%title% %sep% %sitename%"
		},
		"descriptionTemplates": {
			"post": "%excerpt%",
			"page": "%excerpt%"
		},
		"separator": "–",
		"defaultOgImage": 0,
		"twitterHandle": "",
		"twitterCardDefault": "summary_large_image",
		"pagination": {
			"emitPrevNext": false
		},
		"sitemap": {
			"excludedPostTypes": [],
			"excludedTaxonomies": [],
			"addToRobotsTxt": true
		},
		"breadcrumbs": {
			"enableSchema": true,
			"homeLabel": "Home"
		},
		"robotsDefaults": {
			"taxonomies": {},
			"archives": {
				"search": true,
				"date": true,
				"paged": true,
				"404": true,
				"attachment": true,
				"author": "auto"
			},
			"ai": {
				"noai": false,
				"noimageai": false
			}
		},
		"webmaster": {
			"google": "",
			"bing": "",
			"yandex": "",
			"pinterest": "",
			"baidu": ""
		},
		"siteRepresentation": {
			"type": "organization",
			"name": "",
			"logo": 0,
			"personId": 0,
			"social": {
				"facebook": "",
				"instagram": "",
				"linkedin": "",
				"youtube": "",
				"twitter": "",
				"github": "",
				"wikipedia": "",
				"other": []
			}
		},
		"attachmentRedirect": "file",
		"indexNow": {
			"enabled": false,
			"key": ""
		},
		"images": {
			"autoFillAlt": true,
			"includeSitemap": true
		},
		"aiCrawlers": {
			"enabled": true,
			"defaultPolicy": "allow",
			"perBot": {}
		},
		"llmsTxt": {
			"enabled": true,
			"intro": "",
			"outro": "",
			"postTypes": ["page", "post"],
			"perTypeLimit": 200
		}
	},

	"groups": {
		"manage": {
			"general": {
				"isActive": true,
				"icon": "options",
				"title": "General",
				"items": {
					"general": {
						"isActive": true,
						"features": [
							{
								"id": "separator",
								"group": "general",
								"component": "input",
								"name": "Title separator",
								"initial": "–"
							},
							{
								"id": "defaultOgImage",
								"group": "general",
								"component": "media",
								"name": "Default OG image",
								"initial": 0
							},
							{
								"id": "twitterHandle",
								"group": "general",
								"component": "input",
								"name": "Twitter / X handle",
								"initial": ""
							}
						]
					}
				}
			},
			"defaults": {
				"isActive": true,
				"icon": "text",
				"title": "Defaults",
				"items": {
					"general": {
						"isActive": true,
						"features": [
							{
								"id": "titleTemplates",
								"group": "general",
								"component": "custom",
								"name": "Title templates",
								"initial": {
									"post": "%title% %sep% %sitename%",
									"page": "%title% %sep% %sitename%"
								}
							},
							{
								"id": "descriptionTemplates",
								"group": "general",
								"component": "custom",
								"name": "Description templates",
								"initial": {
									"post": "%excerpt%",
									"page": "%excerpt%"
								}
							}
						]
					}
				}
			},
			"sitemap": {
				"isActive": true,
				"icon": "sitemap",
				"title": "Sitemap",
				"items": {
					"general": {
						"isActive": true,
						"features": [
							{
								"id": "sitemap",
								"group": "general",
								"component": "custom",
								"name": "Sitemap settings",
								"initial": {
									"excludedPostTypes": [],
									"excludedTaxonomies": [],
									"addToRobotsTxt": true
								}
							}
						]
					}
				}
			},
			"social": {
				"isActive": true,
				"icon": "share",
				"title": "Social",
				"items": {
					"general": {
						"isActive": true,
						"features": [
							{
								"id": "breadcrumbs",
								"group": "general",
								"component": "custom",
								"name": "Breadcrumb schema",
								"initial": {
									"enableSchema": true,
									"homeLabel": "Home"
								}
							}
						]
					}
				}
			}
		}
	}
}
